# Variables de entorno para conexión opcional con Supabase y encuesta docente
# En Netlify, configure estas variables en: Site settings > Environment variables
# o inyéctelas mediante un script env.js generado en el build (sin hardcodear claves aquí).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica
SURVEY_URL=https://forms.gle/encuesta-ruta-del-condor-ejemplo
